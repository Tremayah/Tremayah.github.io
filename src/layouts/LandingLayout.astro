---
/*  Shell for the single-page site.

    The whole experience is one page: a grid of tiles with every project's
    writeup embedded and revealed in place (see index.astro + site.ts). No nav,
    no marquee, no router — clicking never navigates away. */
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = 'Portfolio of Raphael Murray-Browne — product designer.',
  image = '/images/exploration/lamp-corian.jpg',
} = Astro.props;

// Absolute URLs for link-preview cards (Astro.site = https://tremayah.com).
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

// Structured data for search engines (never rendered): whose site this is, so
// Google can tie "Raphael Murray-Browne", "Tremayah" and tremayah.com together
// in results and AI summaries. Home page only — that's where Google reads the
// site's own name from. sameAs = the profiles linked from the links quad;
// jobTitle/affiliation mirror the contact card's info list (the year is left
// out so it can't go stale).
const home = new URL('/', Astro.site).href;
const identity = Astro.url.pathname === '/' && {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${home}#website`,
      url: home,
      name: 'Raphael Murray-Browne',
      alternateName: 'Tremayah',
      publisher: { '@id': `${home}#person` },
    },
    {
      '@type': 'Person',
      '@id': `${home}#person`,
      name: 'Raphael Murray-Browne',
      url: home,
      jobTitle: 'Product Design student',
      knowsAbout: 'Product design',
      affiliation: {
        '@type': 'CollegeOrUniversity',
        name: 'University of Plymouth',
        address: { '@type': 'PostalAddress', addressLocality: 'Plymouth', addressCountry: 'GB' },
      },
      sameAs: [
        'https://www.instagram.com/rmb_is_designing/',
        'https://www.linkedin.com/in/rmbdesign',
      ],
    },
  ],
};
---

<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#fafafa" />
  {/* Light only: stops browsers' forced dark mode (Chrome on Android, Samsung
      Internet) recolouring the reds/oranges with their own formula. */}
  <meta name="color-scheme" content="only light" />
  <meta name="description" content={description} />
  <meta name="author" content="Raphael Murray-Browne" />
  <title>{title}</title>
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  {/* Open Graph / Twitter — the card shown when the link is shared (LinkedIn,
      WhatsApp, Slack, etc.). */}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Raphael Murray-Browne" />
  <meta property="og:locale" content="en_GB" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  {identity && <script is:inline type="application/ld+json" set:html={JSON.stringify(identity)} />}
  <!-- Warm the font host's connection (once for the CSS, once CORS for the
       font files themselves) before the render-blocking kit CSS is requested. -->
  <link rel="preconnect" href="https://use.typekit.net" />
  <link rel="preconnect" href="https://use.typekit.net" crossorigin />
  <link rel="stylesheet" href="https://use.typekit.net/var1bvf.css" />
</head>
<body class="landing-page">
  <slot />
  <script>
    import '../scripts/site.ts';
  </script>
</body>
</html>
